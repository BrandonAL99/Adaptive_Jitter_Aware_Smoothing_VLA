<mujoco model="pick_place">
  <!--
    Task: pick up the red cube and place it inside the box.
    Success: 0.5 for grasping cube, 0.5 for placing in box.

    Inherits world geometry from world_base.xml via include.
    MuJoCo merges <include> content into the parent document.
  -->
  <include file="world_base.xml"/>

  <asset>
    <material name="mat_cube_red" rgba="0.85 0.0 0.12 1"/>
    <material name="mat_box"      rgba="0.76 0.60 0.42 1"/>
  </asset>

  <worldbody>
    <!-- ── Red cube (~3cm) ──────────────────────────────────────────── -->
    <!-- Spawned in front of robot on mat; randomise in pick_place_env.py -->
    <body name="cube_red" pos="0.0 3 0.845">
      <freejoint name="cube_red_joint"/>
      <geom name="cube_red_geom" type="box" size="0.015 0.015 0.015"
            material="mat_cube_red" mass="0.05"
            contype="1" conaffinity="1" condim="6" friction="4.0 0.5 0.05"/>
    </body>

    <!-- ── Target box (right side) ──────────────────────────────────── -->
    <body name="box_right" pos="0.05 -0.33 0.812">
      <!-- OBJ visual: pos centres mesh on body origin, bottom at body z -->
      <geom name="box_visual" type="mesh" mesh="box_mesh"
            euler="1.5708 0 0" pos="-0.821 -0.039 -0.743"
            rgba="0.76 0.60 0.42 1" contype="0" conaffinity="0"/>
      <!-- Invisible collision: bottom + walls -->
      <geom name="box_bottom"     type="box" size="0.0475 0.0355 0.003" pos="-0.032 0.038 0.003"        rgba="0 0 0 0" contype="1" conaffinity="1" friction="0.3 0.05 0.01"/>
      <geom name="box_wall_front" type="box" size="0.0475 0.003 0.022" pos="-0.032  0.0772 0.025" rgba="0 0 0 0" contype="1" conaffinity="1" friction="0.1 0.01 0.001"/>
      <geom name="box_wall_back"  type="box" size="0.0475 0.003 0.022" pos="-0.032  0.0032 0.025" rgba="0 0 0 0" contype="1" conaffinity="1" friction="0.1 0.01 0.001"/>
      <geom name="box_wall_left"  type="box" size="0.003 0.0355 0.022" pos="-0.081 0.0402 0.025" rgba="0 0 0 0" contype="1" conaffinity="1" friction="0.1 0.01 0.001"/>
      <geom name="box_wall_right" type="box" size="0.003 0.0355 0.022" pos="0.018 0.0402 0.025" rgba="0 0 0 0" contype="1" conaffinity="1" friction="0.1 0.01 0.001"/>
    </body>
  </worldbody>

</mujoco>
