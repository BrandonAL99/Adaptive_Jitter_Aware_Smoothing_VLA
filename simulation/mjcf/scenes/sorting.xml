<mujoco model="sorting">
  <!--
    Task: sort red cube into right box, blue cube into left box.
    Success: 0.25 per cube grasped, 0.25 per cube correctly sorted (max 1.0).
  -->
  <include file="../world_base.xml"/>

  <asset>
    <material name="mat_cube_red"  rgba="0.85 0.12 0.12 1"/>
    <material name="mat_cube_blue" rgba="0.12 0.25 0.85 1"/>
    <material name="mat_box"       rgba="0.76 0.60 0.42 1"/>
  </asset>

  <worldbody>
    <!-- ── Red cube ──────────────────────────────────────────────────── -->
    <body name="cube_red" pos="0.04 0.04 0.845">
      <freejoint name="cube_red_joint"/>
      <geom name="cube_red_geom" type="box" size="0.015 0.015 0.015"
            material="mat_cube_red" mass="0.05"
            contype="1" conaffinity="1" condim="4"/>
    </body>

    <!-- ── Blue cube ─────────────────────────────────────────────────── -->
    <body name="cube_blue" pos="-0.04 0.04 0.845">
      <freejoint name="cube_blue_joint"/>
      <geom name="cube_blue_geom" type="box" size="0.015 0.015 0.015"
            material="mat_cube_blue" mass="0.05"
            contype="1" conaffinity="1" condim="4"/>
    </body>

    <!-- ── Right box (target for red cube) ───────────────────────────── -->
    <body name="box_right" pos="0.22 -0.15 0.812">
      <geom name="box_r_bottom" type="box" size="0.045 0.035 0.003"
            pos="0 0 0" material="mat_box" contype="1" conaffinity="1"/>
      <geom name="box_r_front"  type="box" size="0.045 0.003 0.025" pos="0  0.038 0.025" material="mat_box"/>
      <geom name="box_r_back"   type="box" size="0.045 0.003 0.025" pos="0 -0.038 0.025" material="mat_box"/>
      <geom name="box_r_left"   type="box" size="0.003 0.035 0.025" pos="-0.048 0 0.025" material="mat_box"/>
      <geom name="box_r_right"  type="box" size="0.003 0.035 0.025" pos=" 0.048 0 0.025" material="mat_box"/>
    </body>

    <!-- ── Left box (target for blue cube) ───────────────────────────── -->
    <body name="box_left" pos="-0.22 -0.15 0.812">
      <geom name="box_l_bottom" type="box" size="0.045 0.035 0.003"
            pos="0 0 0" material="mat_box" contype="1" conaffinity="1"/>
      <geom name="box_l_front"  type="box" size="0.045 0.003 0.025" pos="0  0.038 0.025" material="mat_box"/>
      <geom name="box_l_back"   type="box" size="0.045 0.003 0.025" pos="0 -0.038 0.025" material="mat_box"/>
      <geom name="box_l_left"   type="box" size="0.003 0.035 0.025" pos="-0.048 0 0.025" material="mat_box"/>
      <geom name="box_l_right"  type="box" size="0.003 0.035 0.025" pos=" 0.048 0 0.025" material="mat_box"/>
    </body>
  </worldbody>

</mujoco>
